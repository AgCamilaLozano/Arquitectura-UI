{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "incremental": false,
        "declaration": true,
        "declarationDir": "dist",
        "emitDeclarationOnly": true,
        "outDir": "dist"
    },
    "include": [
        "lib/**/*.ts",
        "lib/**/*.tsx",
        "lib/**/*.css",
        "lib/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "app/**/*"
    ]
}