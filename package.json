{
  "name": "@agustin/ui",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles": {
      "style": "./dist/styles.css",
      "import": "./dist/styles.js",
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./fonts": {
      "import": "./dist/fonts.js",
      "types": "./dist/fonts.d.ts"
    },
    "./components": {
      "import": "./dist/components.js",
      "types": "./dist/components.d.ts"
    },
    "./toast": {
      "import": "./dist/toast.js",
      "types": "./dist/toast.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:ui": "tsup",
    "prepare": "pnpm build:ui",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-holidays": "^3.28.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "lucide-react": "^1",
    "next": "^14 || ^15 || ^16",
    "next-themes": "^0.4",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "sonner": "^2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.19.12",
    "esbuild-plugin-copy": "^2.1.1",
    "eslint": "^9",
    "lucide-react": "^1.3.0",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}