{
  "name": "@agustin/ui",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./components": {
      "import": "./dist/components.js",
      "types": "./dist/components.d.ts"
    },
    "./primitives": {
      "import": "./dist/primitives.js",
      "types": "./dist/primitives.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:web": "next dev",
    "build:ui": "tsup && node -e \"const fs = require('fs'); ['dist/components.js', 'dist/primitives.js', 'dist/index.js'].forEach(f => { if(fs.existsSync(f)) { const c = fs.readFileSync(f, 'utf8'); fs.writeFileSync(f, '\\\"use client\\\";\\n' + c); } })\"",
    "clean-install": "node -e \"const fs = require('fs'); fs.rmSync('node_modules', { recursive: true, force: true }); fs.rmSync('pnpm-lock.yaml', { force: true });\" && pnpm install"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-holidays": "^3.28.0",
    "radix-ui": "^1.4.3",
    "tailwind-merge": "^3.0.1"
  },
  "peerDependencies": {
    "lucide-react": "^0.400.0",
    "next": "^14 || ^15 || ^16",
    "next-themes": "^0.4",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "sonner": "^2",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}